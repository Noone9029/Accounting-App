{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "codex/**": false
    }
  },
  "installCommand": "corepack enable && NODE_OPTIONS=--max-old-space-size=4096 UV_THREADPOOL_SIZE=1 corepack pnpm install --frozen-lockfile --child-concurrency=1 --network-concurrency=4",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=4096 UV_THREADPOOL_SIZE=1 corepack pnpm --workspace-concurrency=1 --filter @ledgerbyte/api db:generate",
  "functions": {
    "api/index.ts": {
      "maxDuration": 70,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/internal/recurring-worker",
      "schedule": "*/5 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
